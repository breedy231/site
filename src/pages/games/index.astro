---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getCollection } from "astro:content"

const games = (await getCollection("games")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
)
const itemCount = game =>
  game.data.regions.reduce((sum, region) => sum + region.items.length, 0)
---

<BaseLayout title="Games — Brendan Reed">
  <div class="mx-auto max-w-2xl p-4 font-sans text-gray-900 dark:text-white">
    <h1 class="mb-4 text-3xl leading-tight font-normal">Games</h1>
    <ul class="space-y-3">
      {games.map(game => (
        <li>
          <a
            href={`/games/${game.data.slug}`}
            class="block rounded border border-gray-300 p-4 dark:border-gray-600"
          >
            <span class="block text-lg leading-tight underline decoration-red-500 underline-offset-2">
              {game.data.title}
            </span>
            <span class="mt-1 block text-sm text-gray-500 dark:text-gray-300">
              {game.data.character ? `${game.data.character} · ` : ""}
              {itemCount(game)} items
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
